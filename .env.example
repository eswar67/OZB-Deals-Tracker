# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail ──────────────────────────────────────────────────────────────────
# Recipient address for deal alerts
GMAIL_TO=you@example.com

# ── Google Sheets ──────────────────────────────────────────────────────────
# The long ID from your sheet's URL:
# https://docs.google.com/spreadsheets/d/<SHEETS_ID>/edit
SHEETS_ID=your_sheet_id_here
# Tab/worksheet name (default: Deals)
SHEETS_TAB=Deals

# ── OAuth file paths ───────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
CREDENTIALS_FILE=credentials.json
# Generated by setup_oauth.py — do not share
TOKEN_FILE=token.json

# ── Filter thresholds (optional overrides) ─────────────────────────────────
# Votes/comments/clicks are no longer used for inclusion; savings drives the email.
MIN_VOTES=15
MIN_COMMENTS=5
MIN_CLICKS=50
MAX_AGE_HOURS=999999
MIN_SCORE=7
# Minimum estimated savings in AUD — deals below this are ignored
MIN_SAVINGS=200
# Max /deals HTML pages to crawl. RSS is capped at page 10, so the monitor uses HTML.
OZB_MAX_PAGES=200

# ── Claude token budget controls ───────────────────────────────────────────
# Expensive optional lookup: one Claude call per priced product deal.
ENABLE_MARKET_PRICE_LOOKUP=false
# Expensive optional lookup: one Claude call for free/bonus gifts without a stated value.
LIVE_GIFT_VALUE_LOOKUP=false
# Optional quality/review LLM passes. Savings-only inclusion works with both false.
ENABLE_QUALITY_SCORING=false
ENABLE_PRE_SEND_REVIEW=false
# Max Claude scoring/value fallback calls per run or section.
MAX_PRODUCT_SCORE_DEALS=40
MAX_FINANCIAL_VALUE_DEALS=20
MAX_FINANCIAL_SCORE_DEALS=20
MAX_TRAVEL_VALUE_DEALS=20
MAX_SECTION_SCORE_DEALS=12
